{
  "name": "handsfree",
  "version": "0.1.0",
  "private": true,
  "description": "Hands-free web browsing with a webcam and microphone: head tracking, hand gestures and voice.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-assets.mjs",
    "build": "node scripts/setup-assets.mjs && tsc --noEmit && node scripts/build.mjs",
    "dev": "node scripts/setup-assets.mjs && node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
